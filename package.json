{
  "name": "petalbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/core/src/cli.ts",
    "dev": "node packages/core/scripts/dev.ts",
    "create-plugin": "node packages/create-plugin/src/cli.ts",
    "preview": "node packages/core/scripts/dev.ts --preview",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "docs:api": "node packages/core/scripts/api-docs.ts"
  },
  "devDependencies": {
    "@petalbot/tooling": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
