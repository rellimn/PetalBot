        "display": "dist/overlays/display/display.js"
      }
    }
  },
  "dependencies": {
    "@petalbot/sdk": "workspace:*",
    "@petalbot/ui-sdk": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@petalbot/testing": "workspace:*",
    "@petalbot/tooling": "workspace:*",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.3.4"
  }
}
