{
  "name": "@petalbot-plugin/counter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "petalbot": {
    "id": "counter",
    "apiVersion": 1,
    "entries": {
      "server": "dist/server/server.js",
